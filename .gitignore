# Scratch: bundles and notes assembled by hand during a session. They are
# copies of published release assets, so tracking them would create the stale
# fixed version this file exists to prevent.
deliverables/

# Chat download bundle, not part of the source tree
Tone-Art-Studio-*-source.zip

# Installers are release assets. A copy committed here is a fixed version that
# goes stale and gets handed to someone as "the app" long after it stopped
# being the current one: the desktop kit downloads the newest published build
# instead of shipping a copy (see remote-kit/setup.ps1).
remote-kit/ToneArtStudioSetup-*.exe
