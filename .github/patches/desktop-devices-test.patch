diff --git a/desktop/smoke-test.cjs b/desktop/smoke-test.cjs
index 80da9dc..a0e46fd 100644
--- a/desktop/smoke-test.cjs
+++ b/desktop/smoke-test.cjs
@@ -137,6 +137,19 @@ const fakeElectron = {
     handlers: {},
     handle(channel, handler) { this.handlers[channel] = handler; },
   },
+  // The shell answers device-permission questions through the default session.
+  // The stand-in records those handlers so the answers can be checked: a
+  // microphone or a MIDI port only works in the installed app if this says yes.
+  session: {
+    defaultSession: {
+      requestHandler: null,
+      checkHandler: null,
+      deviceHandler: null,
+      setPermissionRequestHandler(handler) { this.requestHandler = handler; },
+      setPermissionCheckHandler(handler) { this.checkHandler = handler; },
+      setDevicePermissionHandler(handler) { this.deviceHandler = handler; },
+    },
+  },
   // Two displays, so "move this window to the next display" has somewhere to go.
   screen: {
     getPrimaryDisplay: () => FAKE_DISPLAY,
@@ -187,6 +200,66 @@ async function main() {
   assert.strictEqual(studio.options.backgroundColor, '#08090c', 'the first frame must be dark, not white');
   assert.strictEqual(studio.options.resizable, true, 'the studio window must be resizable');
 
+  // --------------------------------------------------------------- devices
+  // A studio is the devices plugged into it. Chromium hands the page neither a
+  // microphone nor a MIDI port until the shell approves the request, so what
+  // the shell answers here decides whether a controller or an audio interface
+  // works at all in the installed app.
+  const permissions = fakeElectron.session.defaultSession;
+  assert.ok(permissions.requestHandler, 'the shell must answer device permission requests');
+  assert.ok(permissions.checkHandler, 'the shell must answer the synchronous permission check');
+
+  const ask = (permission, details, url = calls.loadedUrl) => {
+    let answer = null;
+    permissions.requestHandler(
+      { getURL: () => url },
+      permission,
+      (value) => { answer = value; },
+      details,
+    );
+    return answer;
+  };
+
+  assert.strictEqual(
+    ask('media', { requestingUrl: calls.loadedUrl, mediaTypes: ['audio'] }),
+    true,
+    'the microphone, and so an audio interface, must be approved',
+  );
+  assert.strictEqual(
+    ask('media', { requestingUrl: calls.loadedUrl, mediaTypes: ['video'] }),
+    false,
+    'the camera must not be approved',
+  );
+  assert.strictEqual(
+    ask('midi', { requestingUrl: calls.loadedUrl }),
+    true,
+    'a MIDI controller must be approved',
+  );
+  assert.strictEqual(
+    ask('midiSysex', { requestingUrl: calls.loadedUrl }),
+    true,
+    'sysex must be approved for the controllers that need it',
+  );
+  assert.strictEqual(
+    ask('midi', { requestingUrl: 'https://example.com/' }, 'https://example.com/'),
+    false,
+    'another origin must get no device at all',
+  );
+  assert.strictEqual(
+    permissions.checkHandler({ getURL: () => calls.loadedUrl }, 'midi', calls.loadedUrl, {}),
+    true,
+    'the synchronous check must agree that MIDI is allowed',
+  );
+  assert.strictEqual(
+    permissions.checkHandler({ getURL: () => calls.loadedUrl }, 'geolocation', calls.loadedUrl, {}),
+    false,
+    'a permission the studio does not need must stay refused',
+  );
+  assert.ok(
+    permissions.deviceHandler({ origin: calls.loadedUrl, deviceType: 'audioinput' }),
+    'a device already granted must stay usable on the next page load',
+  );
+
   // ------------------------------------------------------- console windows
   // Two screens from here on: a console's remembered place is only reused when
   // the display it was on is still connected, which is the next thing checked.
@@ -284,6 +357,7 @@ async function main() {
   console.log('desktop shell smoke test passed');
   console.log('  studio window :', calls.loadedUrl);
   console.log('  shown after load, one window, menu built, page isolated');
+  console.log('  devices       : microphone and MIDI approved, camera and other origins refused');
   console.log('  consoles      : own window, resizable, remembered position, closed with the studio');
   process.exit(0);
 }
